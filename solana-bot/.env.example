# Copy to .env locally. Never commit your real .env or wallet secrets.
BOT_MODE=paper
SCAN_INTERVAL_SECONDS=10
PAPER_START_BALANCE_USD=1000
PAPER_TRADE_SIZE_USD=25
PAPER_MAX_OPEN_POSITIONS=5
PAPER_STOP_LOSS_PCT=20
PAPER_TAKE_PROFIT_PCT=40
PAPER_MAX_TOKEN_AGE_MINUTES=1
PAPER_FEE_BPS=100
PAPER_SLIPPAGE_BPS=150
PAPER_COOLDOWN_MINUTES=60
PAPER_MAX_DAILY_LOSS_PCT=10
MIN_LIQUIDITY_USD=5000
MIN_VOLUME_1H_USD=250
MIN_TXNS_1H=8

# Optional official X API recent search. Requires your own X API bearer token.
X_BEARER_TOKEN=
X_SEARCH_QUERY=solana (CA OR contract OR launched OR pump.fun) -is:retweet lang:en
X_POLL_INTERVAL_SECONDS=300

# Optional Telegram control panel. Never commit real values.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the control commands.
TELEGRAM_ALLOWED_USER_IDS=
